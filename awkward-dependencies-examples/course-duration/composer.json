{
    "name": "codesai/course-duration",
    "version": "1.0.0",
    "description": "Course Duration Kata",
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "type": "library",
    "require-dev": {
        "phpunit/phpunit": "12.5.28",
        "phpunit/php-code-coverage": "12.5.7",
        "infection/infection": "0.32.7",
        "phpspec/prophecy-phpunit": "v2.5.0"
    },
    "authors": [
        {
            "name": "Codesai",
            "email": "contact@codesai.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Codesai\\TDD\\CourseDuration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    }
}
